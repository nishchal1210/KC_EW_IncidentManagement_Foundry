# PostgreSQL
POSTGRES_HOST=
POSTGRES_PORT=
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_SSLMODE=
POSTGRES_SCHEMA=

# MCP server
MCP_HOST=
MCP_PORT=
MCP_TRANSPORT=
MCP_SERVER_URL=
LOG_LEVEL=

# Azure OpenAI chat-completion model used only by the optional local grouping classifier.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=
AZURE_OPENAI_DEPLOYMENT=

# Foundry agents/workflows
FOUNDRY_PROJECT_ENDPOINT=
FOUNDRY_INTAKE_AGENT_NAME=
FOUNDRY_GROUPING_AGENT_NAME=
FOUNDRY_ACTION_AGENT_NAME=
FOUNDRY_INVESTIGATION_AGENT_NAME=
FOUNDRY_LIFECYCLE_AGENT_NAME=

# Deployed Foundry Agent OpenAI protocol endpoints. If these URLs do not
# include an api-version query, the app uses FOUNDRY_AGENT_API_VERSION.
FOUNDRY_AGENT_API_VERSION=
FOUNDRY_INTAKE_AGENT_ENDPOINT=
FOUNDRY_GROUPING_AGENT_ENDPOINT=
FOUNDRY_ACTION_AGENT_ENDPOINT=
FOUNDRY_INVESTIGATION_AGENT_ENDPOINT=
FOUNDRY_LIFECYCLE_AGENT_ENDPOINT=

AZURE_TENANT_ID=

# To match the reference ZIP with no browser popup, set these service-principal
# values.
# Legacy TENANT_ID, CLIENT_ID, and CLIENT_SECRET names also work.
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
FOUNDRY_INTERACTIVE_LOGIN=
# Set true only when you intentionally want a browser sign-in fallback.
# On Azure App Service, keep false and enable managed identity instead.
